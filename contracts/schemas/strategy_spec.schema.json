{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eventcontracts/contracts/schemas/strategy_spec.schema.json",
  "title": "StrategySpec",
  "description": "Strategy identity, parameters, subscription, model reference, and default execution priority. Mirrors python/src/eventcontracts/config.py:StrategySpecConfig.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "strategy_id",
    "name",
    "version",
    "description",
    "subscription"
  ],
  "properties": {
    "strategy_id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "feature_schema_id": { "type": "string", "minLength": 1 },
    "subscription": { "$ref": "#/$defs/event_subscription" },
    "default_execution_priority": { "$ref": "#/$defs/execution_priority" },
    "parameters": {
      "type": "object",
      "additionalProperties": { "type": ["string", "number", "boolean"] }
    },
    "model": { "$ref": "#/$defs/model_ref" },
    "tags": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    }
  },
  "$defs": {
    "event_subscription": {
      "type": "object",
      "additionalProperties": false,
      "required": ["venues", "instrument_patterns", "event_kinds"],
      "properties": {
        "venues": {
          "type": "array",
          "items": { "type": "string", "enum": ["kalshi", "polymarket_global"] },
          "minItems": 1
        },
        "instrument_patterns": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        },
        "event_kinds": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "quote",
              "trade",
              "book",
              "lifecycle",
              "settlement",
              "external",
              "timer",
              "own_fill",
              "own_order_update",
              "own_order_reject"
            ]
          },
          "minItems": 1
        },
        "external_sources": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "execution_priority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tier"],
      "properties": {
        "tier": {
          "type": "string",
          "enum": ["relaxed", "standard", "fast", "critical"]
        },
        "max_delay_ms": { "type": "integer", "minimum": 0 },
        "expires_after_ms": { "type": "integer", "minimum": 0 },
        "allow_rate_limit_borrow": { "type": "boolean" },
        "reason": { "type": "string" }
      }
    },
    "model_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "artifact_uri", "sha256"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "artifact_uri": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    }
  }
}
