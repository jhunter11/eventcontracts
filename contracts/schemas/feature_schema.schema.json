{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eventcontracts/contracts/schemas/feature_schema.schema.json",
  "title": "Feature Schema",
  "description": "Ordered description of a FeatureVector. Python and Rust feature builders must produce identical vectors given the same inputs and this schema.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "schema_version", "features"],
  "properties": {
    "schema_id": { "type": "string", "minLength": 1 },
    "schema_version": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "features": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/feature" }
    }
  },
  "$defs": {
    "feature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "dtype"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "dtype": {
          "type": "string",
          "enum": ["float32", "float64", "int32", "int64", "bool", "string"]
        },
        "description": { "type": "string" },
        "nullable": { "type": "boolean", "default": false },
        "default": {
          "description": "Default value used when a source field is missing.",
          "type": ["string", "number", "boolean", "null"]
        }
      }
    }
  }
}
