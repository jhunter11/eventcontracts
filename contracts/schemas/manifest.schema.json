{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eventcontracts/contracts/schemas/manifest.schema.json",
  "title": "Artifact Bundle Manifest",
  "description": "Immutable bundle index produced by the exporter. See docs/artifact-contract.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "bundle_id",
    "created_at",
    "strategy",
    "features",
    "files"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "1" },
    "bundle_id": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "created_by": { "type": "string" },
    "strategy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "strategy_spec"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "strategy_spec": { "type": "string", "description": "Relative path to strategy_spec.toml within the bundle." }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "format"],
      "properties": {
        "name": { "type": "string" },
        "version": { "type": "string" },
        "format": { "type": "string", "enum": ["onnx", "rules"] },
        "path": { "type": "string" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "optional": { "type": "boolean" }
      }
    },
    "sleeve": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sleeve_spec"],
      "properties": {
        "sleeve_spec": { "type": "string", "description": "Relative path to sleeve_spec.toml within the bundle." }
      }
    },
    "features": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "schema_id", "schema_version", "sha256"],
      "properties": {
        "schema": { "type": "string" },
        "schema_id": { "type": "string" },
        "schema_version": { "type": "string" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "parity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cases", "sha256", "expected_rows"],
      "properties": {
        "cases": { "type": "string" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "expected_rows": { "type": "integer", "minimum": 0 }
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "size_bytes": { "type": "integer", "minimum": 0 }
        }
      }
    }
  }
}
