# Local runtime
# The CLI auto-loads the nearest .env, so local commands do not require
# `source .env`.
EVENTCONTRACTS_ENV=local
EVENTCONTRACTS_CONFIG_DIR=configs
EVENTCONTRACTS_DATA_DIR=data
PYTHONPATH=src

# Kalshi
KALSHI_ENV=demo
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=

# Polymarket global CLOB
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=
POLYMARKET_FUNDER_ADDRESS=

# External data
NOAA_TOKEN=
FRED_API_KEY=
BLS_API_KEY=
APIFY_TOKEN=
TMDB_API_KEY=
TRUFLATION_API_KEY=
PROPUBLICA_API_KEY=
OPEN_METEO_BASE_URL=https://api.open-meteo.com
OPEN_METEO_HISTORICAL_FORECAST_BASE_URL=https://historical-forecast-api.open-meteo.com
NWS_BASE_URL=https://api.weather.gov
NWS_USER_AGENT=eventcontracts/0.1 research
NOAA_CDO_BASE_URL=https://www.ncdc.noaa.gov/cdo-web/api/v2
SPACE_DEVS_BASE_URL=https://ll.thespacedevs.com/2.2.0
GDELT_BASE_URL=https://api.gdeltproject.org/api/v2
BINANCE_BASE_URL=https://fapi.binance.com

# Sports data (golf strategy specs in docs/golf-strategy-specs.md)
DATAGOLF_API_KEY=
DATAGOLF_BASE_URL=https://feeds.datagolf.com
PGA_TOUR_API_KEY=
PGA_TOUR_BASE_URL=https://statdata.pgatour.com
SHOTLINK_API_KEY=
SHOTLINK_BASE_URL=https://shotlink.pgatour.com

# Future local dev services
NATS_URL=nats://localhost:4222
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
POSTGRES_DSN=postgresql://eventcontracts:eventcontracts@localhost:5432/eventcontracts
